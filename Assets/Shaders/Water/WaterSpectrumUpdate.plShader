[PLATFORMS]
DESKTOP

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Water/WaterSimulationConstants.h>
#include <Shaders/Water/WaterSpectrumShape.h>

// The wave field of every cascade at the current time, in the frequency domain. Stateless: the random amplitudes
// are a hash of the wave vector and the profile's seed, so nothing has to be kept from frame to frame and a profile
// can change at any time. WaterSpectrumFft turns the result into heights, displacements and slopes.
//
// Eight real fields are transformed as four complex ones (a real field's transform is Hermitian, so two fit into one
// complex transform as A + iB):
//   A.xy = height + i * displacement x        A.zw = displacement y + i * slope x
//   B.xy = slope y + i * d(displacement x)/dx B.zw = d(displacement y)/dy + i * d(displacement x)/dy

StructuredBuffer<plWaterGpuSpectrumProfile> WaterSpectrumProfiles;
RWTexture2DArray<float4> WaterSpectrumFrequencyA;
RWTexture2DArray<float4> WaterSpectrumFrequencyB;

uint HashWaterSpectrum(uint value)
{
  value ^= value >> 16;
  value *= 0x7feb352du;
  value ^= value >> 15;
  value *= 0x846ca68bu;
  return value ^ (value >> 16);
}

// Two independent normal deviates for one wave vector.
float2 WaterGaussianPair(int2 waveIndex, uint seed)
{
  const uint h0 = HashWaterSpectrum(uint(waveIndex.x + 32768) ^ (HashWaterSpectrum(uint(waveIndex.y + 32768) ^ seed) * 0x9e3779b9u));
  const uint h1 = HashWaterSpectrum(h0 ^ 0x68bc21ebu);
  const float u0 = (float(h0 >> 8) + 1.0) / 16777217.0;
  const float u1 = float(h1 >> 8) / 16777216.0;
  const float radius = sqrt(-2.0 * log(u0));
  float s;
  float c;
  sincos(6.2831853 * u1, s, c);
  return float2(radius * c, radius * s);
}

// The amplitude of one wave of the lattice before time is applied.
float2 WaterInitialAmplitude(int2 waveIndex, float domainLength, float bandLow, float bandHigh, plWaterGpuSpectrumProfile profile, uint seed)
{
  const float deltaK = 6.2831853 / domainLength;
  const float2 k = float2(waveIndex) * deltaK;
  const float waveNumber = length(k);
  // Each cascade carries its own band and nothing else, so no wave is counted in two cascades.
  if (waveNumber < max(bandLow, deltaK * 0.5) || waveNumber >= bandHigh)
    return 0.0;

  const float2 wind = normalize(profile.WindDirectionSpeedAmplitude.xy + float2(1.0e-5, 0.0));
  const float density = WaterSpectrumDensity(k.x, k.y, wind.x, wind.y, profile.WaveParams.x, float(profile.ProfileParams.y));
  const float amplitude = sqrt(max(density, 0.0)) * deltaK * profile.WaveParams.w;
  return WaterGaussianPair(waveIndex, seed) * (amplitude * 0.70710678);
}

float2 ComplexMultiply(float2 a, float2 b)
{
  return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

// A + iB for two complex numbers.
float2 ComplexPack(float2 a, float2 b)
{
  return float2(a.x - b.y, a.y + b.x);
}

[numthreads(WATER_SIMULATION_THREAD_GROUP_SIZE, WATER_SIMULATION_THREAD_GROUP_SIZE, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  if (dispatchThreadId.x >= WaterSimulationSize.x || dispatchThreadId.y >= WaterSimulationSize.y || dispatchThreadId.z >= WaterSimulationSize.z)
    return;

  const uint cascadeSlots = max(WaterSimulationSize.z / WATER_MAX_SPECTRUM_PROFILES, 1u);
  const uint profileIndex = min(dispatchThreadId.z / cascadeSlots, WATER_MAX_SPECTRUM_PROFILES - 1u);
  const uint cascadeIndex = dispatchThreadId.z % cascadeSlots;
  const plWaterGpuSpectrumProfile profile = WaterSpectrumProfiles[profileIndex];
  const uint cascadeCount = min(profile.ProfileParams.z, cascadeSlots);
  if (profile.ProfileParams.w == 0u || cascadeIndex >= cascadeCount)
  {
    WaterSpectrumFrequencyA[dispatchThreadId] = 0.0;
    WaterSpectrumFrequencyB[dispatchThreadId] = 0.0;
    return;
  }

  // Texel (x, y) holds the wave with index (x, y) for the lower half and (x - N, y - N) for the upper: the layout
  // an inverse transform expects, with no shift needed afterwards.
  const int size = int(WaterSimulationSize.x);
  const int2 texel = int2(dispatchThreadId.xy);
  const int2 waveIndex = int2(texel.x < size / 2 ? texel.x : texel.x - size, texel.y < size / 2 ? texel.y : texel.y - size);

  const float resolution = float(size);
  const float baseWavelength = max(profile.WaveParams.x, 0.05);
  const float domainLength = WaterCascadeLength(baseWavelength, float(cascadeIndex), float(cascadeCount));
  const float bandHigh = WaterCascadeBandHigh(baseWavelength, float(cascadeIndex), float(cascadeCount), resolution);
  const float bandLow = WaterCascadeBandLow(baseWavelength, float(cascadeIndex), float(cascadeCount), resolution);
  const uint seed = profile.ProfileParams.x ^ (cascadeIndex * 0x85ebca6bu);

  const float2 h0 = WaterInitialAmplitude(waveIndex, domainLength, bandLow, bandHigh, profile, seed);
  const float2 h0Opposite = WaterInitialAmplitude(-waveIndex, domainLength, bandLow, bandHigh, profile, seed);

  const float2 k = float2(waveIndex) * (6.2831853 / domainLength);
  const float waveNumber = length(k);
  float s;
  float c;
  sincos(sqrt(9.81 * waveNumber) * WaterSimulationTime.x, s, c);

  // h(k, t) = h0(k) e^(i w t) + conj(h0(-k)) e^(-i w t): a real height field whose waves travel the way they face.
  const float2 height = ComplexMultiply(h0, float2(c, s)) + ComplexMultiply(float2(h0Opposite.x, -h0Opposite.y), float2(c, -s));

  const float2 direction = waveNumber > 1.0e-6 ? k / waveNumber : float2(0.0, 0.0);
  const float2 iHeight = float2(-height.y, height.x);
  // Horizontal displacement pulls the surface towards the crests: D = -i (k / |k|) h. Slope: grad h = i k h.
  const float2 displacementX = -iHeight * direction.x;
  const float2 displacementY = -iHeight * direction.y;
  const float2 slopeX = iHeight * k.x;
  const float2 slopeY = iHeight * k.y;
  // Derivatives of the displacement, for the Jacobian that says where the surface folds: d/dx = i kx.
  const float2 displacementXX = height * (k.x * direction.x);
  const float2 displacementYY = height * (k.y * direction.y);
  const float2 displacementXY = height * (k.y * direction.x);

  WaterSpectrumFrequencyA[dispatchThreadId] = float4(ComplexPack(height, displacementX), ComplexPack(displacementY, slopeX));
  WaterSpectrumFrequencyB[dispatchThreadId] = float4(ComplexPack(slopeY, displacementXX), ComplexPack(displacementYY, displacementXY));
}
