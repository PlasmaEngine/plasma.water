[PLATFORMS]
ALL

[PERMUTATIONS]

CAMERA_MODE
WATER_RENDER_PASS
WATER_GEOMETRY_SOURCE
WATER_USE_SSR
WATER_USE_TESSELLATION
RENDER_PASS
SHADING_QUALITY = SHADING_QUALITY_NORMAL

[RENDERSTATE]

// The surface pass attaches the opaque depth buffer (read-only via DepthWrite=false) so hardware early-Z
// rejects occluded water before the expensive pixel shader runs. The attributes/volume passes render to
// single-sample attribute targets and cannot attach the potentially multisampled scene depth - they reject
// occluded fragments manually in the shader instead.
DepthWrite = false
CullMode = CullMode_None
#if WATER_RENDER_PASS == WATER_RENDER_PASS_SURFACE
DepthTest = true
DepthTestFunc = CompareFunc_LessEqual
#else
DepthTest = false
#endif
#if RENDER_PASS == RENDER_PASS_WIREFRAME
WireFrame = true
#endif

[VERTEXSHADER]

#define USE_WORLDPOS
#define USE_NORMAL
#define USE_TEXCOORD0
// Undisplaced world position for the junction cutout test. The cutout is authored in base space; testing the
// wave-displaced position instead slides pixels across the analytic boundary and opens flickering gaps.
#define CUSTOM_INTERPOLATOR float2 BaseWorldXY : WATER_BASE_XY; float SpectrumFoam : WATER_SPECTRUM_FOAM;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
#define USE_TANGENT
#define USE_TEXCOORD1
#define USE_COLOR0
#endif

#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Materials/MaterialInterpolator.h>
#include <Shaders/Water/WaterCausticFieldConstants.h>
#include <Shaders/Water/WaterDrawConstants.h>
#include <Shaders/Water/WaterJunctionConstants.h>
#include <Shaders/Water/WaterWaveCommon.h>
#include <Shaders/Water/WaterSurfaceVertex.h>

#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
VS_OUT main(VS_IN Input)
#else
VS_OUT main(uint vertexID : SV_VertexID, uint instanceID : SV_InstanceID)
#endif
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  s_ActiveCameraEyeIndex = Input.InstanceID & 1u;
#else
  s_ActiveCameraEyeIndex = instanceID & 1u;
#endif
#endif

#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_PROCEDURAL
  static const uint2 quadOffsets[6] =
  {
    uint2(0, 0), uint2(1, 0), uint2(0, 1),
    uint2(1, 0), uint2(1, 1), uint2(0, 1),
  };

  const uint cells = max(GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).x, 1u);
  const uint cellIndex = vertexID / 6u;
  const uint vertexInCell = vertexID % 6u;
  const uint2 cell = uint2(cellIndex % cells, cellIndex / cells);
  uint2 gridIndex = cell + quadOffsets[vertexInCell];

  // Ring seams. The ring outside this one has coarser cells, so along the edge where the two meet this patch has
  // vertices the other has not, and waves would open a crack at every one of them. Those vertices move along the edge
  // onto the nearest vertex of the coarser ring: the triangles between collapse, and the two rings share the edge.
  // plWaterGeometry::SnapOceanSeamIndex is the same rule in C++.
  const uint seams = GET_PUSH_CONSTANT(plWaterDrawConstants, ProfileParams).w;
  const uint outerSeamMask = (seams >> 4u) & 0xFu;
  const uint seamRatio = (seams >> 16u) & 0xFFu;
  float spacingScale = 1.0;
  if (outerSeamMask != 0u && seamRatio > 1u)
  {
    const bool onWestOrEast = (gridIndex.x == 0u && (outerSeamMask & 1u) != 0u) || (gridIndex.x == cells && (outerSeamMask & 2u) != 0u);
    const bool onSouthOrNorth = (gridIndex.y == 0u && (outerSeamMask & 4u) != 0u) || (gridIndex.y == cells && (outerSeamMask & 8u) != 0u);
    if (onWestOrEast)
      gridIndex.y = ((gridIndex.y + seamRatio / 2u) / seamRatio) * seamRatio;
    if (onSouthOrNorth)
      gridIndex.x = ((gridIndex.x + seamRatio / 2u) / seamRatio) * seamRatio;
    // And they read the waves at the coarser ring's scale, as that ring's own vertices on this edge do.
    if (onWestOrEast || onSouthOrNorth)
      spacingScale = float(seamRatio);
  }
  // The inner edges of a ring are the outer edges of the ring inside it, whose vertices were just moved here: nothing to do.
  float2 uv = float2(gridIndex) / float(cells);
  const float4 originAndHeight = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchOriginAndBaseHeight);
  const float4 axisUAndExtent = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchAxisUAndExtent);
  const float4 axisVAndExtent = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchAxisVAndExtent);
  float3 baseWorldPosition = originAndHeight.xyz + axisUAndExtent.xyz * (uv.x * axisUAndExtent.w) + axisVAndExtent.xyz * (uv.y * axisVAndExtent.w);
  baseWorldPosition.z += originAndHeight.w;
  float waveAttenuation = 1.0;
  float2 vertexFlowDirection = float2(1.0, 0.0);
  // No vertices to carry a profile pair: both indices say "the draw's own".
  float4 profilePair = float4(0.0, 1.0, 1.0, 1.0);
#else
  float spacingScale = 1.0;
  float2 uv = Input.TexCoord0;
  float3 baseWorldPosition = Input.Position;
  float waveAttenuation = saturate(Input.TexCoord1.x);
  const float2 tangentXY = Input.Tangent.xy;
  float2 vertexFlowDirection = dot(tangentXY, tangentXY) > 1.0e-10 ? normalize(tangentXY) : float2(1.0, 0.0);
  float4 profilePair = Input.Color0;
#endif

#if WATER_USE_TESSELLATION
  // Hull/domain stages need the undisplaced control triangle. The domain shader interpolates these base
  // attributes and evaluates the same displacement function at every generated point.
  VS_OUT output = (VS_OUT)0;
  output.Position = float4(baseWorldPosition, 1.0);
  output.WorldPosition = baseWorldPosition;
  output.Normal = float3(0.0, 0.0, 1.0);
  output.TexCoord0 = uv;
  output.BaseWorldXY = baseWorldPosition.xy;
  // The domain stage has no other way to learn that a vertex lies on a ring seam.
  output.SpectrumFoam = spacingScale;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  output.Tangent = float3(vertexFlowDirection, 0.0);
  output.BiTangent = float3(-vertexFlowDirection.y, vertexFlowDirection.x, 0.0);
  output.TexCoord1 = float2(waveAttenuation, 0.0);
  output.Color0 = profilePair;
#endif
#if CAMERA_MODE == CAMERA_MODE_STEREO
  output.RenderTargetArrayIndex = s_ActiveCameraEyeIndex;
#endif
  return output;
#else
  return EvaluateWaterSurfaceVertex(baseWorldPosition, uv, waveAttenuation, vertexFlowDirection, profilePair, spacingScale);
#endif
}

[HULLSHADER]

#if WATER_USE_TESSELLATION
#define USE_WORLDPOS
#define USE_NORMAL
#define USE_TEXCOORD0
#define CUSTOM_INTERPOLATOR float2 BaseWorldXY : WATER_BASE_XY; float SpectrumFoam : WATER_SPECTRUM_FOAM;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
#define USE_TANGENT
#define USE_TEXCOORD1
#define USE_COLOR0
#endif

#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Materials/MaterialInterpolator.h>
#include <Shaders/Water/WaterJunctionConstants.h>

struct WaterTessellationFactors
{
  float Edge[3] : SV_TessFactor;
  float Inside : SV_InsideTessFactor;
};

float WaterEdgeTessellationFactor(VS_OUT a, VS_OUT b)
{
  const float maxFactor = max(TessellationParams.x, 1.0);
  const float targetPixels = max(TessellationParams.y, 8.0);
  const float3 midpoint = (a.WorldPosition + b.WorldPosition) * 0.5;
  const float distanceToCamera = length(GetCameraPosition() - midpoint);

  float factor = 1.0;
  const float4 clipA = mul(GetWorldToScreenMatrix(), float4(a.WorldPosition, 1.0));
  const float4 clipB = mul(GetWorldToScreenMatrix(), float4(b.WorldPosition, 1.0));
  if (clipA.w > 1.0e-4 && clipB.w > 1.0e-4 && distanceToCamera < 24.0)
  {
    const float2 pixelA = (clipA.xy / clipA.w * float2(0.5, -0.5) + 0.5) * ViewportSize.xy;
    const float2 pixelB = (clipB.xy / clipB.w * float2(0.5, -0.5) + 0.5) * ViewportSize.xy;
    factor = ceil(length(pixelB - pixelA) / targetPixels);
  }

  if (TessellationParams.w > 0.5)
  {
    const float2 edgeMin = min(a.WorldPosition.xy, b.WorldPosition.xy);
    const float2 edgeMax = max(a.WorldPosition.xy, b.WorldPosition.xy);
    const bool touchesInteraction = edgeMax.x >= ActiveInteractionBounds.x && edgeMax.y >= ActiveInteractionBounds.y &&
                                    edgeMin.x <= ActiveInteractionBounds.z && edgeMin.y <= ActiveInteractionBounds.w;
    if (touchesInteraction)
      factor = max(factor, TessellationParams.z);
  }

  // Whole-number factors taken from the edge alone: the two parts of a network that share an edge tessellate it alike.
  return clamp(factor, 1.0, maxFactor);
}

WaterTessellationFactors WaterPatchConstants(InputPatch<VS_OUT, 3> patch)
{
  WaterTessellationFactors factors;
  factors.Edge[0] = WaterEdgeTessellationFactor(patch[1], patch[2]);
  factors.Edge[1] = WaterEdgeTessellationFactor(patch[2], patch[0]);
  factors.Edge[2] = WaterEdgeTessellationFactor(patch[0], patch[1]);
  factors.Inside = max(max(factors.Edge[0], factors.Edge[1]), factors.Edge[2]);
  return factors;
}

[domain("tri")]
[outputcontrolpoints(3)]
[outputtopology("triangle_cw")]
[partitioning("integer")]
[patchconstantfunc("WaterPatchConstants")]
VS_OUT main(InputPatch<VS_OUT, 3> patch, uint id : SV_OutputControlPointID)
{
  return patch[id];
}
#endif

[DOMAINSHADER]

#if WATER_USE_TESSELLATION
#define USE_WORLDPOS
#define USE_NORMAL
#define USE_TEXCOORD0
#define CUSTOM_INTERPOLATOR float2 BaseWorldXY : WATER_BASE_XY; float SpectrumFoam : WATER_SPECTRUM_FOAM;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
#define USE_TANGENT
#define USE_TEXCOORD1
#define USE_COLOR0
#endif

#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Materials/MaterialInterpolator.h>
#include <Shaders/Water/WaterCausticFieldConstants.h>
#include <Shaders/Water/WaterDrawConstants.h>
#include <Shaders/Water/WaterJunctionConstants.h>
#include <Shaders/Water/WaterWaveCommon.h>
#include <Shaders/Water/WaterSurfaceVertex.h>

struct WaterTessellationFactors
{
  float Edge[3] : SV_TessFactor;
  float Inside : SV_InsideTessFactor;
};

[domain("tri")]
VS_OUT main(WaterTessellationFactors factors, OutputPatch<VS_OUT, 3> patch,
  float3 barycentric : SV_DomainLocation)
{
  const float3 baseWorldPosition = patch[0].WorldPosition * barycentric.x +
                                   patch[1].WorldPosition * barycentric.y +
                                   patch[2].WorldPosition * barycentric.z;
  const float2 uv = patch[0].TexCoord0 * barycentric.x + patch[1].TexCoord0 * barycentric.y +
                    patch[2].TexCoord0 * barycentric.z;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  const float waveAttenuation = saturate(patch[0].TexCoord1.x * barycentric.x +
                                          patch[1].TexCoord1.x * barycentric.y +
                                          patch[2].TexCoord1.x * barycentric.z);
  float2 vertexFlowDirection = patch[0].Tangent.xy * barycentric.x + patch[1].Tangent.xy * barycentric.y +
                               patch[2].Tangent.xy * barycentric.z;
  vertexFlowDirection = dot(vertexFlowDirection, vertexFlowDirection) > 1.0e-10
                          ? normalize(vertexFlowDirection)
                          : float2(1.0, 0.0);
  // The pair is the same at all three corners; only the weight varies across the triangle.
  const float4 profilePair = float4(saturate(patch[0].Color0.r * barycentric.x + patch[1].Color0.r * barycentric.y +
                                             patch[2].Color0.r * barycentric.z),
    patch[0].Color0.gba);
#else
  const float waveAttenuation = 1.0;
  const float2 vertexFlowDirection = float2(1.0, 0.0);
  const float4 profilePair = float4(0.0, 1.0, 1.0, 1.0);
#endif
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = patch[0].RenderTargetArrayIndex;
#endif
  // A point of a ring seam lies between two corners that are both on the seam; the third corner's weight is zero there.
  float spacingScale = 1.0;
  if (barycentric.x < 1.0e-4)
    spacingScale = min(patch[1].SpectrumFoam, patch[2].SpectrumFoam);
  else if (barycentric.y < 1.0e-4)
    spacingScale = min(patch[2].SpectrumFoam, patch[0].SpectrumFoam);
  else if (barycentric.z < 1.0e-4)
    spacingScale = min(patch[0].SpectrumFoam, patch[1].SpectrumFoam);
  return EvaluateWaterSurfaceVertex(baseWorldPosition, uv, waveAttenuation, vertexFlowDirection, profilePair, max(spacingScale, 1.0));
}
#endif

[PIXELSHADER]

#define USE_WORLDPOS
#define USE_NORMAL
#define USE_TEXCOORD0
// Must mirror the vertex-shader defines exactly (including CUSTOM_INTERPOLATOR): the interpolator struct is
// generated per stage and the stages are linked by location index, not by semantic. A leaner pixel-shader
// struct shifts every interpolator after Normal, so Color0 (the junction profile blend) would read the vertex
// shader's BiTangent slot instead.
#define CUSTOM_INTERPOLATOR float2 BaseWorldXY : WATER_BASE_XY; float SpectrumFoam : WATER_SPECTRUM_FOAM;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
#define USE_TANGENT
#define USE_TEXCOORD1
#define USE_COLOR0
#endif

#include <Shaders/Common/Common.h>
#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Common/GBufferEncoding.h>
#include <Shaders/Materials/MaterialData.h>
#include <Shaders/Materials/MaterialInterpolator.h>
#include <Shaders/Common/Lighting.h>
#include <Shaders/Materials/MaterialGIForwardLighting.h>
#include <Shaders/Water/WaterCausticFieldConstants.h>
#include <Shaders/Water/WaterDrawConstants.h>
#include <Shaders/Water/WaterJunctionConstants.h>
#include <Shaders/Water/WaterWaveCommon.h>
#include <Shaders/Water/WaterProfile.h>
#include <Shaders/Water/WaterSpectrumShape.h>

Texture2DArray WaterSceneColor BIND_GROUP(BG_RENDER_PASS);
Texture2DArray WaterOpaqueDepth BIND_GROUP(BG_RENDER_PASS);
// The wave spectrum's cascades, as in WaterSurfaceVertex.h. The vertices carry the waves the mesh can show; here the
// rest of them become normals.
Texture2DArray WaterSpectrumDisplacement BIND_GROUP(BG_RENDER_PASS);
Texture2DArray WaterSpectrumSlope BIND_GROUP(BG_RENDER_PASS);

// What the spectrum adds to a pixel beyond what its vertices already hold.
struct WaterSpectrumDetail
{
  float2 Gradient; // height gradient of the waves between the vertices
  float Variance;  // slope variance of the waves smaller than the pixel: they cannot be drawn, only blur the reflection
  float Fold;      // how far the surface is folded over itself here, 0..1
};

WaterSpectrumDetail EvaluateWaterSpectrumDetail(plWaterGpuProfile profile, float2 baseWorldXY, uint spectrumLayers)
{
  WaterSpectrumDetail detail;
  detail.Gradient = 0.0;
  detail.Variance = 0.0;
  detail.Fold = 0.0;

  const uint cascadeSlots = max(spectrumLayers / 4u, 1u);
  const uint cascadeCount = spectrumLayers > 0u ? min(min((uint)profile.SpectrumParams.y, cascadeSlots), 4u) : 0u;
  if (cascadeCount == 0u)
    return detail;

  const float4 surfaceParams = GET_PUSH_CONSTANT(plWaterDrawConstants, SurfaceParams);
  const float vertexSpacing = max(surfaceParams.y, 0.01);
  const float resolution = max(surfaceParams.z, 2.0);
  const uint firstSpectrumLayer = min((uint)profile.SpectrumParams.x, 3u) * cascadeSlots;
  [unroll]
  for (uint cascade = 0u; cascade < 4u; ++cascade)
  {
    if (cascade >= cascadeCount)
      break;
    const float domainLength = WaterCascadeLength(profile.WaveParams.y, float(cascade), float(cascadeCount));
    const float3 uv = float3(baseWorldXY / domainLength, firstSpectrumLayer + cascade);
    const float vertexLod = max(log2(vertexSpacing * resolution / domainLength), 0.0);

    // The mip the pixel covers, and the mip its vertices read. Their difference is the detail that lies between the
    // vertices. Far away the pixel's mip is the coarser one, and the difference takes back what the vertices show of
    // waves that are smaller than a pixel.
    const float4 pixelSlope = WaterSpectrumSlope.Sample(LinearSampler, uv);
    const float4 vertexSlope = WaterSpectrumSlope.SampleLevel(LinearSampler, uv, vertexLod);
    detail.Gradient += pixelSlope.xy - vertexSlope.xy;
    // A mip holds the mean of the slopes and the mean of their squares. What is missing between the two is the
    // variance of the slopes that were averaged away.
    detail.Variance += max(pixelSlope.z - dot(pixelSlope.xy, pixelSlope.xy), 0.0);
    detail.Fold = max(detail.Fold, WaterSpectrumDisplacement.Sample(LinearSampler, uv).w);
  }
  return detail;
}
// One detail normal and one foam texture per draw: the drawing body's. A blend with another profile samples the same
// pair with that profile's scale and drift.
Texture2D WaterNormalTexture BIND_GROUP(BG_DRAW_CALL);
Texture2D WaterFoamTexture BIND_GROUP(BG_DRAW_CALL);

// Flow mapping. A texture that is simply slid along a current tears apart wherever the current turns, and the longer
// it runs the worse it gets: after ten minutes in a river bend nothing of the pattern is left. Instead the pattern is
// only ever slid for a few seconds, twice, half a cycle apart, and each copy is faded out before it is reset and the
// other one shows. The offset never grows, so the pattern looks the same after an hour as after a second.
float4 SampleWaterAlongFlow(Texture2D tex, float2 uv, float2 uvVelocity, float time)
{
  const float cycle = 3.2;
  const float phase0 = frac(time / cycle);
  const float phase1 = frac(time / cycle + 0.5);
  const float weight0 = 1.0 - abs(phase0 * 2.0 - 1.0);
  const float4 sample0 = tex.Sample(LinearSampler, uv + uvVelocity * ((phase0 - 0.5) * cycle));
  const float4 sample1 = tex.Sample(LinearSampler, uv + uvVelocity * ((phase1 - 0.5) * cycle) + float2(0.37, 0.61));
  return lerp(sample1, sample0, weight0);
}

// One profile's detail normal: two layers of the normal texture at different scales.
float2 SampleWaterProfileNormalDetail(plWaterGpuProfile profile, float3 worldPosition, float2 flowVelocity, float simulationTime)
{
  if (profile.FoamMaterialParams.w <= 0.5)
    return 0.0;

  const float detailScale = max(profile.SurfaceDetailParams.x, 0.05);
  float2 detail0;
  float2 detail1;
  if (profile.SpectrumParams.w > 0.5)
  {
    // A river: the detail travels with the current.
    detail0 = SampleWaterAlongFlow(WaterNormalTexture, worldPosition.xy * (0.045 * detailScale), flowVelocity * 0.025, simulationTime).xy * 2.0 - 1.0;
    detail1 = SampleWaterAlongFlow(WaterNormalTexture, worldPosition.yx * (0.083 * detailScale), -flowVelocity.yx * 0.017, simulationTime).xy * 2.0 - 1.0;
  }
  else
  {
    // A lake or an ocean: one direction of drift everywhere, which can be slid for ever.
    const float2 uv0 = worldPosition.xy * (0.045 * detailScale) + flowVelocity * simulationTime * 0.025 + float2(simulationTime * 0.018, simulationTime * 0.011);
    const float2 uv1 = worldPosition.yx * (0.083 * detailScale) - flowVelocity.yx * simulationTime * 0.017 + float2(-simulationTime * 0.013, simulationTime * 0.021);
    detail0 = WaterNormalTexture.Sample(LinearSampler, uv0).xy * 2.0 - 1.0;
    detail1 = WaterNormalTexture.Sample(LinearSampler, uv1).xy * 2.0 - 1.0;
  }
  return (detail0 + detail1 * 0.55) * profile.SurfaceDetailParams.y;
}

float3 ApplyWaterNormalDetail(float3 baseNormal, float3 worldPosition, plWaterGpuProfile profileA, plWaterGpuProfile profileB,
  float profileBlend, float2 primaryFlow, float2 secondaryFlow)
{
  const float simulationTime = GET_PUSH_CONSTANT(plWaterDrawConstants, SurfaceParams).x;
  float2 detail = SampleWaterProfileNormalDetail(profileA, worldPosition, primaryFlow, simulationTime);
  [branch]
  if (profileBlend > 0.0)
    detail = lerp(detail, SampleWaterProfileNormalDetail(profileB, worldPosition, secondaryFlow, simulationTime), profileBlend);

  const float distanceFade = saturate(1.0 - length(GetCameraPosition() - worldPosition) / 900.0);
  // Interaction slope is deliberately absent here: ripples are geometry. Adding it per pixel makes a coarse
  // mesh look embossed like a normal map even when its silhouette has not moved.
  return normalize(baseNormal + float3(detail.x, detail.y, 0.0) * lerp(0.25, 1.0, distanceFade));
}

float ProceduralWaterFoamBreakup(float2 position, float scale)
{
  scale = max(abs(scale), 0.001);
  return saturate(0.5
    + 0.28 * sin(position.x * scale) * sin(position.y * scale * 1.6180)
    + 0.16 * sin(position.x * scale * 2.4142 + 1.7) * sin(position.y * scale * 3.3028 + 0.4)
    + 0.06 * sin((position.x + position.y) * scale * 5.0952 + 3.1));
}

// One profile's foam pattern: where foam is thick and where it is thin.
float SampleWaterProfileFoamBreakup(plWaterGpuProfile profile, float3 worldPosition, float simulationTime, float2 flowVelocity)
{
  const float scale = max(abs(profile.FoamMaterialParams.y), 0.001);
  if (profile.SpectrumParams.w > 0.5 && profile.FoamMaterialParams.z > 0.5)
  {
    // A river: foam rides the current, flow mapped like the detail normals.
    const float foam0 = SampleWaterAlongFlow(WaterFoamTexture, worldPosition.xy * scale, -flowVelocity * scale, simulationTime).r;
    const float foam1 = SampleWaterAlongFlow(WaterFoamTexture, worldPosition.yx * (scale * 0.61), -flowVelocity.yx * (scale * 0.61), simulationTime).r;
    return saturate(foam0 * 0.62 + foam1 * 0.38);
  }

  const float2 position = worldPosition.xy + flowVelocity * simulationTime + profile.WindAndFlow.xy * simulationTime * 0.15;
  if (profile.FoamMaterialParams.z > 0.5)
  {
    const float foam0 = WaterFoamTexture.Sample(LinearSampler, position * scale).r;
    const float foam1 = WaterFoamTexture.Sample(LinearSampler,
      position.yx * (scale * 0.61) + float2(simulationTime * 0.013, -simulationTime * 0.009)).r;
    return saturate(foam0 * 0.62 + foam1 * 0.38);
  }
  return ProceduralWaterFoamBreakup(position, scale);
}

float SampleWaterFoamBreakup(plWaterGpuProfile profileA, plWaterGpuProfile profileB, float3 worldPosition, float profileBlend,
  float simulationTime, float2 primaryFlow, float2 secondaryFlow)
{
  // A body's own water and the pure ends of a mix evaluate one profile only.
  if (profileBlend <= 0.0001)
    return SampleWaterProfileFoamBreakup(profileA, worldPosition, simulationTime, primaryFlow);
  if (profileBlend >= 0.9999)
    return SampleWaterProfileFoamBreakup(profileB, worldPosition, simulationTime, secondaryFlow);

  return lerp(SampleWaterProfileFoamBreakup(profileA, worldPosition, simulationTime, primaryFlow),
    SampleWaterProfileFoamBreakup(profileB, worldPosition, simulationTime, secondaryFlow), profileBlend);
}

// The cutout is evaluated on the UNDISPLACED world position: the boundary is authored in base space and the
// junction patch covers exactly that base-space footprint. Testing the wave-displaced position instead lets
// choppy waves carry pixels across the analytic boundary, discarding surface the patch does not cover.
bool InsideJunctionCutout(float2 baseWorldXY, float4 cutout, float4 dimensions)
{
  if (dimensions.x <= 0.0)
    return false;
  const float2 direction = dot(cutout.zw, cutout.zw) > 1.0e-10 ? normalize(cutout.zw) : float2(1.0, 0.0);
  const float2 perpendicular = float2(-direction.y, direction.x);
  const float2 delta = baseWorldXY - cutout.xy;
  const float longitudinal = dot(delta, direction);
  const float t = longitudinal / (dimensions.x * 2.0) + 0.5;
  // Up the river the cutout has the river's width. From the river's end it widens as the apron's fan does (the same
  // easing over the same stretch), so it never reaches past the fan's edge.
  const float widen = saturate((t - dimensions.w) / max(1.0 - dimensions.w, 1.0e-4));
  const float halfWidth = lerp(dimensions.y, dimensions.z, widen * widen * (3.0 - 2.0 * widen));
  return t >= 0.0 && t <= 1.0 && abs(dot(delta, perpendicular)) <= halfWidth;
}

// An ocean patch leaves out the inside of a river's apron, which is drawn after it and covers the same water.
void RejectJunctionOverlap(float2 baseWorldXY)
{
  if (GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).w != 0u)
    return;
  if (InsideJunctionCutout(baseWorldXY, JunctionCutout0, JunctionCutout1) ||
      InsideJunctionCutout(baseWorldXY, JunctionCutout2, JunctionCutout3))
    discard;
}

// How a profile's detail normals and foam drift: a river's along the mesh's flow direction, a lake's with the pair
// of scalars its look was tuned against, an ocean's not at all (its wind term is added where the textures are sampled).
float2 EvaluateWaterDetailVelocity(plWaterGpuProfile profile, float2 flowDirection)
{
  return profile.SpectrumParams.w > 0.5 ? flowDirection * (profile.WindAndFlow.z * profile.WindAndFlow.w) : profile.WindAndFlow.zw;
}

// Where a current runs into waves, the water breaks. How hard depends on both: no current or no waves, no churn.
float EvaluateWaterMouthFoam(plWaterGpuProfile profileA, plWaterGpuProfile profileB, float profileBlend)
{
  const float currentA = profileA.SpectrumParams.w > 0.5 ? abs(profileA.WindAndFlow.z * profileA.WindAndFlow.w) : 0.0;
  const float currentB = profileB.SpectrumParams.w > 0.5 ? abs(profileB.WindAndFlow.z * profileB.WindAndFlow.w) : 0.0;
  const float wavesA = profileA.SpectrumParams.w > 0.5 ? 0.0 : max(profileA.WaveParams.x, 0.0) * max(profileA.WaveParams.z, 0.1);
  const float wavesB = profileB.SpectrumParams.w > 0.5 ? 0.0 : max(profileB.WaveParams.x, 0.0) * max(profileB.WaveParams.z, 0.1);
  const float currentPush = max(currentA, currentB);
  const float wavePush = max(wavesA, wavesB);
  const float pushback = wavePush / max(wavePush + currentPush, 1.0e-4);
  const float contest = 4.0 * pushback * (1.0 - pushback);
  const float front = saturate(4.0 * profileBlend * (1.0 - profileBlend));
  return contest * min((currentPush + wavePush) * 0.25, 1.0) * front * front;
}

float LoadWaterOpaqueDepth(float2 pixelPosition, uint eyeIndex)
{
  return WaterOpaqueDepth.Load(int4(int2(pixelPosition), eyeIndex, 0)).r;
}

float3 ProjectWaterWorldToScreen(float3 worldPosition, out float projectionValid)
{
  const float4 clipPosition = mul(GetWorldToScreenMatrix(), float4(worldPosition, 1.0));
  projectionValid = step(1.0e-4, clipPosition.w);
  const float3 projected = clipPosition.xyz / max(clipPosition.w, 1.0e-4);
  return float3(projected.xy * float2(0.5, -0.5) + 0.5, projected.z);
}

float2 ProjectWaterWorldToUV(float3 worldPosition, out float projectionValid)
{
  return ProjectWaterWorldToScreen(worldPosition, projectionValid).xy;
}

// Bounded inline SSR for the water surface. Quality-selected samples find the first opaque-depth crossing and
// tiered bisection samples refine it. Conservative validity weights make the existing probe/sky
// lighting take over at silhouettes, off-screen rays, rough water, and numerically unstable grazing angles.
float3 TraceWaterScreenSpaceReflection(float3 worldPosition, float3 reflectionDirection, float surfaceLinearDepth,
  float perceptualRoughness, float noV, uint eyeIndex, float jitter, out float reflectionValidity)
{
  reflectionValidity = 0.0;
  const float3 cameraForward = normalize(GetCameraDirForwards());
  if (dot(reflectionDirection, cameraForward) <= 1.0e-3)
    return 0.0;

  const float maxTraceDistance = lerp(55.0, 18.0, saturate(perceptualRoughness));
  float previousDistance = 0.08;
  // The visible water surface is already in front of the opaque depth at the ray origin. Treat the
  // self-intersection offset as the initial front sample so nearby reflectors remain bracketed.
  bool hasFrontSample = true;
  const uint stepCount = clamp((uint)WaterQualityParams.x, 1u, 8u);

  [unroll]
  for (uint stepIndex = 0u; stepIndex < 8u; ++stepIndex)
  {
    if (stepIndex >= stepCount)
      break;

    // Reserve the first tap for near-field reflections, then spread the remaining taps cubically to
    // retain the authored far range with High's four-step budget.
    // Each pixel starts its steps at a different point between two of them. A handful of fixed steps shows as bands
    // where every pixel misses the same thin reflector; jittered, the bands become noise that the temporal filter
    // averages into the reflection.
    const float normalizedStep = saturate((float(stepIndex) + jitter) / float(stepCount));
    const float traceDistance = 0.08 + maxTraceDistance * normalizedStep * normalizedStep * normalizedStep;
    float projectionValid;
    const float3 projected = ProjectWaterWorldToScreen(worldPosition + reflectionDirection * traceDistance, projectionValid);
    if (projectionValid < 0.5 || projected.z <= 0.0 || projected.z >= 1.0 || any(projected.xy <= 0.001) || any(projected.xy >= 0.999))
      break;

    const float rawSceneDepth = WaterOpaqueDepth.SampleLevel(PointClampSampler, float3(projected.xy, eyeIndex), 0).r;
    const float sceneLinearDepth = LinearizeZBufferDepth(rawSceneDepth);
    const float rayLinearDepth = LinearizeZBufferDepth(projected.z);
    const float depthDelta = rayLinearDepth - sceneLinearDepth;
    const float depthThickness = max(0.08, sceneLinearDepth * 0.0025);

    if (hasFrontSample && depthDelta >= -depthThickness)
    {
      float frontDistance = previousDistance;
      float backDistance = traceDistance;
      float2 hitUV = projected.xy;
      float hitDepth = sceneLinearDepth;
      float hitDelta = depthDelta;

      // Refine only confirmed crossings. High uses two bisections for its 1440p budget; Ultra uses four.
      const uint refinementCount = stepCount >= 8u ? 4u : 2u;
      [unroll]
      for (uint refinement = 0u; refinement < 4u; ++refinement)
      {
        if (refinement >= refinementCount)
          break;

        const float refineDistance = 0.5 * (frontDistance + backDistance);
        float refineProjectionValid;
        const float3 refineProjected = ProjectWaterWorldToScreen(worldPosition + reflectionDirection * refineDistance, refineProjectionValid);
        if (refineProjectionValid < 0.5 || refineProjected.z <= 0.0 || refineProjected.z >= 1.0 ||
            any(refineProjected.xy <= 0.001) || any(refineProjected.xy >= 0.999))
          break;

        const float refineRawDepth = WaterOpaqueDepth.SampleLevel(PointClampSampler, float3(refineProjected.xy, eyeIndex), 0).r;
        const float refineSceneDepth = LinearizeZBufferDepth(refineRawDepth);
        const float refineRayDepth = LinearizeZBufferDepth(refineProjected.z);
        const float refineDelta = refineRayDepth - refineSceneDepth;
        const float refineThickness = max(0.08, refineSceneDepth * 0.0025);
        if (refineDelta < -refineThickness)
        {
          frontDistance = refineDistance;
        }
        else
        {
          backDistance = refineDistance;
          hitUV = refineProjected.xy;
          hitDepth = refineSceneDepth;
          hitDelta = refineDelta;
        }
      }

      const float hitThickness = max(0.08, hitDepth * 0.0025);
      const float edgeDistance = min(min(hitUV.x, hitUV.y), min(1.0 - hitUV.x, 1.0 - hitUV.y));
      const float edgeValidity = smoothstep(0.0, 0.045, edgeDistance);
      const float depthValidity = 1.0 - smoothstep(hitThickness, hitThickness * 5.0, abs(hitDelta));
      const float roughnessValidity = 1.0 - smoothstep(0.22, 0.65, perceptualRoughness);
      const float grazingValidity = smoothstep(0.025, 0.12, noV);
      // Do not let a depth discontinuity in front of this water pixel become an immediate false hit.
      const float receiverValidity = smoothstep(surfaceLinearDepth * 0.25, surfaceLinearDepth * 0.75, hitDepth);
      reflectionValidity = edgeValidity * depthValidity * roughnessValidity * grazingValidity * receiverValidity;
      return WaterSceneColor.SampleLevel(LinearClampSampler, float3(hitUV, eyeIndex), 0).rgb * SceneColorToAbsolute();
    }

    if (depthDelta < -depthThickness)
    {
      hasFrontSample = true;
      previousDistance = traceDistance;
    }
  }

  return 0.0;
}

// How much of the sun reaches a point on the water surface: the engine's shadow map (virtual pages or cascades) and
// its cloud shadows, looked up at the surface's own world position. Contact shadows are left out on purpose: they
// are traced from the opaque depth buffer, so on a water pixel they describe the bed below, not the surface.
float EvaluateWaterSunShadow(float3 worldPosition, float3 surfaceNormal, float3 screenPosition, out float3 out_debugColor)
{
  out_debugColor = float3(1.0, 0.0, 1.0); // magenta: the view has no directional light
  if (BrightestDirectionalLightIndex >= NumLights)
    return 1.0;

  const plPerLightData lightData = perLightDataBuffer[BrightestDirectionalLightIndex];
  const uint type = (lightData.colorAndType >> 24) & 0xFF;
  if (type != LIGHT_TYPE_DIR)
    return 1.0;

  const float3 lightVector = normalize(RGB10ToFloat3(lightData.direction) * 2.0 - 1.0);
  out_debugColor = float3(1.0, 1.0, 0.0); // yellow: the sun casts no shadows
  if (lightData.shadowDataOffsetAndFadeOut == 0)
    return SampleCloudShadowTerm(worldPosition);

  const float noise = InterleavedGradientNoise(screenPosition.xy);
  float2 randomAngle;
  sincos(noise * 2.0 * PI, randomAngle.x, randomAngle.y);
  const float2x2 randomRotation = {randomAngle.x, -randomAngle.y, randomAngle.y, randomAngle.x};
  float subsurfaceShadow = 1.0;
  // Green where the shadow map covers the point, red where it does not (the lookup then answers "lit").
  const float shadowTerm = saturate(CalculateShadowTerm(worldPosition, surfaceNormal, lightVector, 1.0, type, lightData.shadowDataOffsetAndFadeOut,
    noise, randomRotation, 1.0, subsurfaceShadow, out_debugColor));
  return shadowTerm;
}

void ComputeWaterDepths(PS_IN input, uint eyeIndex, out float surfaceLinearDepth, out float opaqueLinearDepth)
{
  const float opaqueDepth = LoadWaterOpaqueDepth(input.Position.xy, eyeIndex);
  surfaceLinearDepth = LinearizeZBufferDepth(input.Position.z);
  opaqueLinearDepth = LinearizeZBufferDepth(opaqueDepth);
}

void RejectOccludedWater(PS_IN input, uint eyeIndex, out float surfaceLinearDepth, out float opaqueLinearDepth)
{
  ComputeWaterDepths(input, eyeIndex, surfaceLinearDepth, opaqueLinearDepth);
  clip(opaqueLinearDepth + max(0.01, surfaceLinearDepth * 0.0005) - surfaceLinearDepth);
}

#if WATER_RENDER_PASS == WATER_RENDER_PASS_VOLUME

float main(PS_IN input) : SV_Target0
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = input.RenderTargetArrayIndex;
#endif
  const uint geometryType = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).w;
  if (geometryType == 1u)
    discard;
  const uint4 volumeFilter = GET_PUSH_CONSTANT(plWaterDrawConstants, VolumeFilterParams);
  if (volumeFilter.w == 0u || volumeFilter.z != volumeFilter.x)
    discard;
  RejectJunctionOverlap(input.BaseWorldXY);
  return LinearizeZBufferDepth(input.Position.z);
}

#elif WATER_RENDER_PASS == WATER_RENDER_PASS_CAUSTIC_FIELD

struct WaterCausticFieldOutput
{
  float Height : SV_Target0;
  float4 SurfaceData : SV_Target1;
};

WaterCausticFieldOutput main(PS_IN input)
{
  const uint geometryType = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).w;
  if (geometryType == 3u)
    discard;
  RejectJunctionOverlap(input.BaseWorldXY);

  uint profileIndexA;
  uint profileIndexB;
  float profileBlend = 0.0;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  DecodeWaterProfilePair(input.Color0, profileIndexA, profileIndexB, profileBlend);
#else
  GetWaterDrawProfilePair(profileIndexA, profileIndexB);
#endif
  const float2 causticStrength = max(lerp(LoadWaterProfile(profileIndexA).CausticParams.xy, LoadWaterProfile(profileIndexB).CausticParams.xy, profileBlend), 0.0);

  WaterCausticFieldOutput output;
  output.Height = input.WorldPosition.z;
  output.SurfaceData = float4(EncodeNormalOctahedral(normalize(input.Normal)), causticStrength);
  return output;
}

#elif WATER_RENDER_PASS == WATER_RENDER_PASS_ATTRIBUTES

float main(PS_IN input) : SV_Target0
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = input.RenderTargetArrayIndex;
#endif
  const uint eyeIndex = s_ActiveCameraEyeIndex;
  const uint geometryType = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).w;
  if (geometryType == 3u)
    discard;
  RejectJunctionOverlap(input.BaseWorldXY);
  float surfaceLinearDepth;
  float opaqueLinearDepth;
  RejectOccludedWater(input, eyeIndex, surfaceLinearDepth, opaqueLinearDepth);

  return surfaceLinearDepth;
}

#else

float4 main(PS_IN input) : SV_Target0
{
#if CAMERA_MODE == CAMERA_MODE_STEREO
  s_ActiveCameraEyeIndex = input.RenderTargetArrayIndex;
#endif
  const uint eyeIndex = s_ActiveCameraEyeIndex;
  const uint geometryType = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).w;
  if (geometryType == 3u)
    discard;
  RejectJunctionOverlap(input.BaseWorldXY);

  uint profileIndexA;
  uint profileIndexB;
  float profileBlend = 0.0;
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  DecodeWaterProfilePair(input.Color0, profileIndexA, profileIndexB, profileBlend);
#else
  GetWaterDrawProfilePair(profileIndexA, profileIndexB);
#endif
  const plWaterGpuProfile profileA = LoadWaterProfile(profileIndexA);
  const plWaterGpuProfile profileB = LoadWaterProfile(profileIndexB);

#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  [branch]
  if (profileIndexA != profileIndexB && profileBlend > 0.0 && profileBlend < 1.0)
  {
    // The mix of two waters is not a ramp across the mouth: its front is ragged. The breakup is a function of the
    // position and the weight alone, so the river's side and the receiver's side of a mouth line agree on it, and it
    // is nothing where either water is pure. How ragged is the junction's Front Breakup, carried in the vertex alpha.
    const float frontTime = GET_PUSH_CONSTANT(plWaterDrawConstants, SurfaceParams).x;
    const float2 p = input.BaseWorldXY;
    const float frontNoise = sin(dot(p, float2(2.1, 1.3)) + frontTime * 0.31) * sin(dot(p, float2(-1.7, 2.9)) - frontTime * 0.23) * 0.6 +
                             sin(dot(p, float2(5.3, -4.1)) - frontTime * 0.47) * sin(dot(p, float2(3.9, 6.7)) + frontTime * 0.41) * 0.4;
    const float blendInterior = 4.0 * profileBlend * (1.0 - profileBlend);
    profileBlend = saturate(profileBlend + frontNoise * saturate(input.Color0.a) * 0.45 * blendInterior);
  }
#endif
  const float materialProfileBlend = profileBlend;

#if RENDER_PASS == RENDER_PASS_WIREFRAME
  if (RenderPass == WIREFRAME_RENDER_PASS_MONOCHROME)
    return float4(0.4, 0.4, 0.4, 1.0);
  return float4(lerp(profileA.ShallowColor.rgb, profileB.ShallowColor.rgb, materialProfileBlend), 1.0);
#endif

#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE && RENDER_PASS == RENDER_PASS_FORWARD
  // Water.Debug.Stitch (or Water.Debug.JunctionPatches 1): the profile weights on rivers and lakes. A body's own water
  // is dark blue; where two waters mix, the first of the pair is magenta and the second green. Modes 3+ fall through
  // to the shading-term views at the end of the shader.
  {
    const uint debugMode = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).z;
    if (debugMode == 1u)
    {
      if (profileIndexA == profileIndexB)
        return float4(0.02, 0.05, 0.25, 1.0);
      return float4(lerp(float3(1.0, 0.0, 1.0), float3(0.0, 1.0, 0.0), profileBlend), 1.0);
    }
  }
#endif

  // The surface pass depth-tests against the attached opaque depth buffer (hardware early-Z), so no manual
  // occlusion clip is needed here - the depths are only required for thickness and refraction.
  float surfaceLinearDepth;
  float opaqueLinearDepth;
  ComputeWaterDepths(input, eyeIndex, surfaceLinearDepth, opaqueLinearDepth);

  const float2 uv = input.Position.xy * ViewportSize.zw;

#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  const float2 flowTangent = dot(input.Tangent.xy, input.Tangent.xy) > 1.0e-10 ? normalize(input.Tangent.xy) : float2(1.0, 0.0);
#else
  const float2 flowTangent = float2(1.0, 0.0);
#endif
  const float2 primaryFlowVelocity = EvaluateWaterDetailVelocity(profileA, flowTangent);
  const float2 secondaryFlowVelocity = EvaluateWaterDetailVelocity(profileB, flowTangent);

  // Interaction data is deliberately absent from the pixel stage. Its only visible contribution is the
  // displaced vertex position and coherent vertex normal produced above; no atlas-shaped shading is painted
  // over the resulting geometry.
  // The waves of the spectrum that the mesh is too coarse for. Two profiles mix as their wave fields do in the
  // vertex stage: with weights whose squares add up to one.
  const uint spectrumLayers = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).y;
  WaterSpectrumDetail spectrumDetail = EvaluateWaterSpectrumDetail(profileA, input.BaseWorldXY, spectrumLayers);
  [branch]
  if (profileIndexA != profileIndexB && profileBlend > 0.0)
  {
    const WaterSpectrumDetail other = EvaluateWaterSpectrumDetail(profileB, input.BaseWorldXY, spectrumLayers);
    spectrumDetail.Gradient = spectrumDetail.Gradient * sqrt(1.0 - profileBlend) + other.Gradient * sqrt(profileBlend);
    spectrumDetail.Variance = lerp(spectrumDetail.Variance, other.Variance, profileBlend);
    spectrumDetail.Fold = lerp(spectrumDetail.Fold, other.Fold, profileBlend);
  }
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
  const float pixelWaveAttenuation = saturate(input.TexCoord1.x);
#else
  const float pixelWaveAttenuation = 1.0;
#endif
  const float3 vertexNormal = normalize(input.Normal);
  const float2 vertexGradient = -vertexNormal.xy / max(vertexNormal.z, 0.1);
  const float3 waveNormal = normalize(float3(-(vertexGradient + spectrumDetail.Gradient * pixelWaveAttenuation), 1.0));

  const float3 surfaceNormal = ApplyWaterNormalDetail(
    waveNormal, input.WorldPosition, profileA, profileB, materialProfileBlend, primaryFlowVelocity, secondaryFlowVelocity);
  const float3 viewDirection = normalize(GetCameraPosition() - input.WorldPosition);
  // The distance from the surface to whatever is behind it, measured along the camera's axis. This is what the depth
  // buffer gives, and it is only used to get at the two measures that mean something to water: how deep the water is
  // under the pixel (verticalDepth) and how far the light travels through it (waterPathLength). Where there is no
  // bed at all, both are very large and the water takes its deep colour.
  const float thickness = max(opaqueLinearDepth - surfaceLinearDepth, 0.0);
  const float4 absorptionAndRoughness = lerp(profileA.AbsorptionAndRoughness, profileB.AbsorptionAndRoughness, materialProfileBlend);
  const float4 scatteringAndIor = lerp(profileA.ScatteringAndIor, profileB.ScatteringAndIor, materialProfileBlend);
  const float4 shallowColor = lerp(profileA.ShallowColor, profileB.ShallowColor, materialProfileBlend);
  const float4 deepColor = lerp(profileA.DeepColor, profileB.DeepColor, materialProfileBlend);
  const float4 opticalParams = lerp(profileA.OpticalParams, profileB.OpticalParams, materialProfileBlend);
  const float4 foamParams = lerp(profileA.FoamParams, profileB.FoamParams, materialProfileBlend);
  const float4 surfaceDetailParams = lerp(profileA.SurfaceDetailParams, profileB.SurfaceDetailParams, materialProfileBlend);
  const float4 foamMaterialParams = lerp(profileA.FoamMaterialParams, profileB.FoamMaterialParams, materialProfileBlend);
  const float4 foamColor = lerp(profileA.FoamColor, profileB.FoamColor, materialProfileBlend);

  // Always orient the interface normal towards the medium containing the camera. This makes the same
  // double-sided surface valid from air and from water, and gives the refraction calculation the correct
  // relative IOR in each direction.
  // Determine the incident medium from the macro surface, not the high-frequency detail normal: tiny normal-map
  // facets must not flip the camera between air and water at grazing angles.
  // The side comes from the triangle itself, not from a normal: far away, where a triangle spans a whole wave, the
  // interpolated normal of its far slope faces away from the camera although the camera is above the water, and the
  // pixel was shaded as seen from below. The surface is a height field, so the face normal that points up is its top.
  float3 faceNormal = cross(ddx(input.WorldPosition), ddy(input.WorldPosition));
  faceNormal = faceNormal.z >= 0.0 ? faceNormal : -faceNormal;
  // And only an underwater camera can see the surface from below at all. For a camera in the air the answer is known
  // without looking at the triangle, which matters where a triangle is seen nearly edge on (the far sea at eye level)
  // and its face normal is a matter of rounding: such pixels showed the bare sea bed.
  const bool cameraIsUnderwater = GET_PUSH_CONSTANT(plWaterDrawConstants, VolumeFilterParams).w != 0u;
  const bool cameraOnNormalSide = !cameraIsUnderwater || dot(faceNormal, viewDirection) >= 0.0;
  const float3 normal = cameraOnNormalSide ? surfaceNormal : -surfaceNormal;
  const float noV = saturate(dot(normal, viewDirection));
  const float ior = max(scatteringAndIor.w, 1.0);
  const float incidentIor = cameraOnNormalSide ? 1.0 : ior;
  const float transmittedIor = cameraOnNormalSide ? ior : 1.0;
  float cosTransmitted;
  const float fresnel = EvaluateWaterDielectricFresnel(noV, incidentIor, transmittedIor, cosTransmitted);
  const float3 incidentDirection = -viewDirection;
  const float3 refractionDirection = EvaluateWaterRefractionDirection(incidentDirection, normal, incidentIor, transmittedIor, noV, cosTransmitted);

  // How deep the water is under this pixel: the drop from the surface to the point of the bed that lies straight
  // behind it. Over a level bed that is the water's depth from every direction, which the distance along the view ray
  // is not: measured that way, a shore band was wide from above and thin from the side.
  const float3 cameraForward = normalize(GetCameraDirForwards());
  const float incidentForward = max(dot(incidentDirection, cameraForward), 0.05);
  const float directPathLength = thickness / incidentForward;
  const float verticalDepth = cameraOnNormalSide ? max(-incidentDirection.z * directPathLength, 0.0) : 0.0;

  const float refractionStrength = clamp(foamParams.w, 0.0, 0.03);
  const float refractionDepthFade = 1.0 - exp(-verticalDepth / max(opticalParams.z * 0.25, 0.01));
  const float refractionGrazingFade = smoothstep(0.03, 0.2, noV);
  const float edgeDistance = min(min(uv.x, uv.y), min(1.0 - uv.x, 1.0 - uv.y));
  const float refractionEdgeFade = smoothstep(0.0, lerp(0.002, 0.08, saturate(surfaceDetailParams.w)), edgeDistance);

  // Trace the refracted WORLD-SPACE ray to approximately the opaque receiver's view depth, then project it
  // back to screen space. Unlike normal.xy UV offsets this remains correct as the camera rotates and responds
  // to the profile IOR. RefractionDepth caps the trace where extinction has already hidden deeper detail.
  const float refractedForward = dot(refractionDirection, cameraForward);
  const float traceForwardDepth = min(thickness, max(opticalParams.z * 2.0, 0.25));
  const float traceDistance = traceForwardDepth / max(refractedForward, 0.05);
  float projectionValid;
  const float2 physicalRefractionUV = ProjectWaterWorldToUV(input.WorldPosition + refractionDirection * traceDistance, projectionValid);
  const float refractionAmount = saturate(refractionStrength / 0.03);
  const float transmissionValid = 1.0 - step(0.9999, fresnel);
  const float rayValid = step(1.0e-3, refractedForward);
  const float2 candidateRefractionUVUnclamped = lerp(uv, physicalRefractionUV,
    refractionAmount * refractionDepthFade * refractionGrazingFade * refractionEdgeFade);
  const float candidateInsideViewport = step(0.0, candidateRefractionUVUnclamped.x) * step(candidateRefractionUVUnclamped.x, 1.0) *
    step(0.0, candidateRefractionUVUnclamped.y) * step(candidateRefractionUVUnclamped.y, 1.0);
  const float2 candidateRefractionUV = clamp(candidateRefractionUVUnclamped, 0.001, 0.999);
  const float candidateOpaqueDepth = LinearizeZBufferDepth(WaterOpaqueDepth.SampleLevel(PointClampSampler, float3(candidateRefractionUV, eyeIndex), 0).r);
  const float foregroundReject = smoothstep(surfaceLinearDepth + 0.01, surfaceLinearDepth + max(0.1, thickness * 0.08), candidateOpaqueDepth);
  const float refractionValid = projectionValid * rayValid * transmissionValid * candidateInsideViewport * foregroundReject;
  const float2 refractionUV = lerp(uv, candidateRefractionUV, refractionValid);
  // Scene color is pre-exposed; water shades in absolute radiance and pre-exposes its result.
  const float sceneColorToAbsolute = SceneColorToAbsolute();
  const float3 undistortedSceneColor = WaterSceneColor.SampleLevel(LinearClampSampler, float3(uv, eyeIndex), 0).rgb * sceneColorToAbsolute;
  const float3 sceneColor = WaterSceneColor.SampleLevel(LinearClampSampler, float3(refractionUV, eyeIndex), 0).rgb * sceneColorToAbsolute;
  // The same two measures for the bed that the refracted ray shows, where there is one on screen.
  const float refractedPathLength = max(candidateOpaqueDepth - surfaceLinearDepth, 0.0) / max(refractedForward, 0.05);
  const float refractedVerticalDepth = max(-refractionDirection.z * refractedPathLength, 0.0);
  const float waterDepth = cameraOnNormalSide ? lerp(verticalDepth, refractedVerticalDepth, refractionValid) : 0.0;
  // Light from the bed comes up through the water along the refracted ray, which is never far from vertical (48
  // degrees at most): its path is the depth over the ray's vertical share. From below, the transmitted ray leaves the
  // water at once, and the underwater composite has already applied what lies between the camera and the surface.
  const float waterPathLength = waterDepth / max(abs(refractionDirection.z), 0.5);

  // One optical model. The profile gives an extinction per metre for each colour and the colour of deep water; what
  // is seen through the surface is the bed, dimmed by the water above it, plus the water's own colour for as much of
  // the path as is water. Extinction is fitted to Shallow Color: white sand under Refraction Depth metres of water
  // looks like it. See plWaterFillGpuProfile.
  const float3 transmittance = exp(-max(absorptionAndRoughness.xyz, 0.0) * waterPathLength);
  const float3 refractedSceneColor = sceneColor * transmittance;

  const float f0 = pow((ior - 1.0) / (ior + 1.0), 2.0);
  // Shore foam: thickest where the water runs out, and beyond that in lines that follow the depth and travel up the
  // beach, as the last of each wave does. Lines of equal depth are lines along the shore, whatever its shape.
  const float shoreRamp = 1.0 - saturate(verticalDepth / max(foamParams.z, 0.01));
  const float lapTime = GET_PUSH_CONSTANT(plWaterDrawConstants, SurfaceParams).x;
  const float lapPhase = verticalDepth / max(foamParams.z, 0.01) * 9.0 + lapTime * 0.9 + sin(dot(input.BaseWorldXY, float2(0.37, 0.23))) * 1.3;
  const float lapLines = pow(saturate(sin(lapPhase) * 0.5 + 0.5), 6.0);
  const float shoreFoam = saturate(pow(shoreRamp, 3.0) + lapLines * shoreRamp * 0.6);
  const float crestFoam = saturate((foamParams.y - surfaceNormal.z) / max(foamParams.y * 0.35, 0.02));
  const float spectralFoam = saturate(max(input.SpectrumFoam, spectrumDetail.Fold * pixelWaveAttenuation));
  // River mouth churn: where the outflowing current and the incoming waves contest each other the water
  // breaks into foam. The strength is precomputed from the two bodies' energies (zero when either side is
  // calm) and the band peaks at the blend front, which the energy balance has already positioned.
  float mouthFoam = 0.0;
  [branch]
  if (profileIndexA != profileIndexB)
    mouthFoam = EvaluateWaterMouthFoam(profileA, profileB, profileBlend);
  const float breakingFoam = max(crestFoam, spectralFoam);
  const float unbrokenBaseFoam = max(max(shoreFoam, breakingFoam), mouthFoam);
  float baseFoam = 0.0;
  [branch]
  if (unbrokenBaseFoam > 1.0e-4)
  {
    const float simulationTime = GET_PUSH_CONSTANT(plWaterDrawConstants, SurfaceParams).x;
    const float breakup = SampleWaterFoamBreakup(
      profileA, profileB, input.WorldPosition, materialProfileBlend, simulationTime, primaryFlowVelocity, secondaryFlowVelocity);
    baseFoam = unbrokenBaseFoam * smoothstep(0.2, 0.8, breakup);
  }
  const float foam = saturate(baseFoam * max(foamParams.x, 0.0));

  const float slopeVariance = saturate(length(fwidth(normal.xy)) * 3.0);
  // Waves smaller than the pixel cannot be drawn as normals. What they do to a reflection is spread it, and that is
  // what roughness is: the variance of their slopes is added to the squared GGX alpha.
  const float baseRoughness = saturate(max(absorptionAndRoughness.w, 0.025) + slopeVariance * 0.35);
  const float baseAlpha = baseRoughness * baseRoughness;
  const float perceptualRoughness = saturate(sqrt(sqrt(baseAlpha * baseAlpha + min(spectrumDetail.Variance * pixelWaveAttenuation, 0.25))));
  plMaterialData materialData = (plMaterialData)0;
  materialData.worldPosition = input.WorldPosition;
  // The engine's lights look their shadows up here. Left at zero, every water pixel took the shadow of the world origin.
  materialData.shadowPosition = input.WorldPosition;
  materialData.worldNormal = normal;
  materialData.vertexNormal = cameraOnNormalSide ? normalize(input.Normal) : -normalize(input.Normal);
  materialData.diffuseColor = foamColor.rgb;
  materialData.specularColor = f0.xxx;
  materialData.roughness = perceptualRoughness * perceptualRoughness;
  materialData.perceptualRoughness = perceptualRoughness;
  materialData.occlusion = 1.0;
  materialData.opacity = 1.0;
  const plPerClusterData clusterData = GetClusterData(input.Position.xyw);
  // Direct light uses the surface's own roughness, which by now holds the slopes of every wave smaller than the pixel:
  // that is what gives the sun's reflection its width, wide and soft far away and a narrow sparkle up close. (A fixed
  // floor of 0.2 stood in for it before, and turned every glint into a glowing patch.) The floor that is left only
  // keeps a mirror-flat surface from collapsing the sun into a single pixel of unbounded radiance.
  const float directPerceptualRoughness = max(perceptualRoughness, 0.06);
  plMaterialData directMaterialData = materialData;
  directMaterialData.perceptualRoughness = directPerceptualRoughness;
  directMaterialData.roughness = directPerceptualRoughness * directPerceptualRoughness;
  const AccumulatedLight engineLighting = CalculateLightingDirectOnly(directMaterialData, clusterData, input.Position.xyw, false);

  // The sun on water: its light, and whether it gets here. The engine's shadow map is looked up at the surface's own
  // position, so a cliff, a bridge or a cloud shades the water under it.
  const float3 mainLightVector = MainLightDirection.xyz;
  const float mainLightLengthSquared = dot(mainLightVector, mainLightVector);
  const float mainLightSignal = dot(max(MainLightColorIntensity.rgb, 0.0), float3(0.2126, 0.7152, 0.0722));
  const float mainLightValid = step(1.0e-6, mainLightLengthSquared) * step(1.0e-6, mainLightSignal);
  const float3 mainLightDirection = mainLightVector * rsqrt(max(mainLightLengthSquared, 1.0e-6));
  float3 sunShadowCoverage;
  const float sunShadow = mainLightValid > 0.0 ? EvaluateWaterSunShadow(input.WorldPosition, float3(0.0, 0.0, 1.0), input.Position.xyw, sunShadowCoverage) : 1.0;
  const float3 sunRadiance = MainLightColorIntensity.rgb * (mainLightValid * sunShadow);

  // What lights the surface (foam), and what lights the water below it. The water's own colour is light scattered
  // back out of its depth, which does not follow every ripple: it takes the light that falls on the level surface.
  const float noL = saturate(dot(normal, mainLightDirection));
  const float3 ambientIrradiance = EvaluateAmbientCube(SkyIrradianceTexture, SkyIrradianceIndex, normal).rgb;
  const float3 diffuseIrradiance = sunRadiance * noL * INV_PI + ambientIrradiance;
  const float3 levelNormal = cameraOnNormalSide ? float3(0.0, 0.0, 1.0) : float3(0.0, 0.0, -1.0);
  const float3 volumeIrradiance = sunRadiance * saturate(mainLightDirection.z) * INV_PI + EvaluateAmbientCube(SkyIrradianceTexture, SkyIrradianceIndex, levelNormal).rgb;
  const float lightingSignal = dot(volumeIrradiance, float3(0.2126, 0.7152, 0.0722));
  const float missingLighting = 1.0 - smoothstep(0.002, 0.04, lightingSignal);
  // Some valid scenes intentionally have no sun, sky light, or reflection probe. Preserve a restrained amount of
  // radiance from the pre-water scene and a small neutral floor so deep water remains legible instead of becoming
  // mathematically black. The fallback fades away as soon as real irradiance is available.
  const float3 lowEnergySceneFallback = max(undistortedSceneColor * 0.06, float3(0.006, 0.008, 0.01)) + deepColor.rgb * 0.035;
  const float3 volumeColor = deepColor.rgb * volumeIrradiance + lowEnergySceneFallback * missingLighting;

  // Light that enters the back of a wave and comes out of its face: the green glow of a crest seen against the sun.
  // It needs the sun behind the wave and a view through the wave's thin top, which the surface normal bends towards.
  const float3 crestLightDirection = normalize(mainLightDirection + normal * 0.35);
  const float crestThrough = pow(saturate(dot(viewDirection, -crestLightDirection)), 4.0);
  const float crestThin = saturate(1.0 - vertexNormal.z) * 4.0 + saturate(spectrumDetail.Fold);
  const float3 crestScattering = lerp(deepColor.rgb, shallowColor.rgb, 0.6) * sunRadiance * INV_PI * (crestThrough * saturate(crestThin) * (cameraOnNormalSide ? 1.0 : 0.0));

  const float3 transmittedColor = refractedSceneColor + volumeColor * (1.0 - transmittance) + crestScattering;
  // For the debug views: the water's own colour before light, and with it.
  const float3 authoredTint = lerp(shallowColor.rgb, deepColor.rgb, saturate(1.0 - dot(transmittance, float3(0.333, 0.333, 0.334))));
  const float3 litTint = volumeColor * (1.0 - transmittance);

  const float3 environmentBrdf = EnvironmentBRDF(materialData.specularColor, materialData.roughness, noV);
  // Water selects one indirect reflection source explicitly; clustered lighting above is direct-only.
  // The probe is asked for the sky a rough sea shows, not for its mirror image. A wave field reflects the sky from
  // well above the horizon on average: slopes that would show the horizon itself are hidden behind the waves in front
  // of them. And a probe's horizon is the worst of it, a blur of sky with whatever lies below, which in a sky-light
  // probe is the bare ground without any water on it. So the direction is lifted, more the rougher the surface is.
  plMaterialData reflectionMaterialData = materialData;
  if (cameraOnNormalSide)
  {
    float3 r = reflect(-viewDirection, normal);
    if (r.z < 0.0)
      r.z = -r.z * 0.5;
    r.z = max(r.z, 0.2 + perceptualRoughness * 0.6);
    r = normalize(r);
    reflectionMaterialData.worldNormal = normalize(r + viewDirection);
  }
  const float3 probeRadiance = ComputeReflection(reflectionMaterialData, viewDirection, clusterData, input.Position.xyw);
  const float3 giSpecularRadiance = SampleGIForwardSpecular(input.Position.xyw, input.WorldPosition) * GISpecularStrength;
  const float giSpecularValid = (GIForwardEnabled != 0 && GIForwardReflectionsEnabled != 0) ? 1.0 : 0.0;
  const float3 stableEnvironmentRadiance = lerp(probeRadiance, giSpecularRadiance, giSpecularValid);
  // Reflection parameters are energy weights. Clamping them prevents an authored multiplier from producing
  // more reflected radiance than arrives at the interface.
  const float reflectionStrength = saturate(opticalParams.x);
  const float environmentReflectionWeight = reflectionStrength * saturate(opticalParams.y);
  float3 reflectionDirection = reflect(-viewDirection, normal);
  // A ray that leaves a wave downwards meets water again, and what it shows in the end is sky from lower down, not
  // the ground half of a probe. Without a second bounce, the ray is turned back up: seen from above, far water near
  // the horizon reflected the probe's floor as a brown band.
  if (cameraOnNormalSide && reflectionDirection.z < 0.0)
    reflectionDirection = normalize(float3(reflectionDirection.xy, -reflectionDirection.z * 0.5 + 0.02));
  float ssrValidity = 0.0;
  float3 ssrRadiance = 0.0;
#if WATER_USE_SSR
  [branch]
  if (environmentReflectionWeight > 1.0e-4)
    ssrRadiance = TraceWaterScreenSpaceReflection(input.WorldPosition, reflectionDirection, surfaceLinearDepth,
      perceptualRoughness, noV, eyeIndex, InterleavedGradientNoise(input.Position.xy), ssrValidity);
#endif
  // A valid water-aware SSR hit replaces the stable probe / GI source before BRDF weighting. Reflection
  // sources are selected, never accumulated, so a bright sky cannot be counted by multiple systems.
  const float3 resolvedEnvironmentRadiance = lerp(stableEnvironmentRadiance, ssrRadiance, ssrValidity);
  const float3 resolvedEnvironmentReflection = resolvedEnvironmentRadiance * environmentBrdf;
  // The sun's reflection. The engine's lights give it too, with contact shadows that were traced for the bed and not
  // for the surface, so the sun is evaluated here with its own shadow and the larger of the two is taken: both are the
  // same lobe, and the engine's stays in charge of every other light. Sun Glitter Strength is an artist's dimmer:
  // 0.5 and above is the sun as it is.
  const float glitterStrength = saturate(surfaceDetailParams.z * 2.0);
  const AccumulatedLight glitterBrdf = DefaultShading(directMaterialData, mainLightDirection, viewDirection);
  const float3 analyticSunGlitter = sunRadiance * glitterBrdf.specularLight * INV_PI * reflectionStrength;
  const float3 directReflection = max(engineLighting.specularLight * reflectionStrength * sunShadow, analyticSunGlitter * glitterStrength);
  float3 reflectionLighting = directReflection + resolvedEnvironmentReflection * environmentReflectionWeight;

  // When a world has neither a SkyLight nor a reflection probe, the engine reflection result is black.
  // Preserve the physically authored water response by falling back to sky irradiance when available and finally to
  // the profile's own scattering tint when neither SSR nor the engine reflection source provides radiance.
  const float3 skyIrradiance = EvaluateAmbientCube(SkyIrradianceTexture, SkyIrradianceIndex, reflectionDirection).rgb;
  const float3 authoredEnvironment = lerp(deepColor.rgb, shallowColor.rgb, saturate(abs(surfaceNormal.z) * 0.75 + 0.25)) * diffuseIrradiance;
  const float skySignal = dot(skyIrradiance, float3(0.2126, 0.7152, 0.0722));
  const float reflectionSignal = dot(resolvedEnvironmentReflection * environmentReflectionWeight, float3(0.2126, 0.7152, 0.0722));
  // Smooth luminance ramps instead of near-step saturate(x*32) thresholds, which popped between the
  // engine reflection and the authored fallback when a scene hovered around the threshold.
  const float3 environmentFallback = lerp(max(authoredEnvironment * 0.35, lowEnergySceneFallback), skyIrradiance, smoothstep(0.005, 0.05, skySignal));
  const float environmentFallbackVisibility = 1.0 - smoothstep(0.005, 0.06, reflectionSignal);
  reflectionLighting += environmentFallback * environmentBrdf * environmentReflectionWeight * environmentFallbackVisibility;

#if RENDER_PASS == RENDER_PASS_FORWARD
  // Water.Debug.JunctionPatches modes 3+ visualize individual shading terms on ALL water surfaces.
  {
    const uint debugMode = GET_PUSH_CONSTANT(plWaterDrawConstants, PatchParams).z;
    if (debugMode >= 3u)
    {
      if (debugMode == 3u)
        return float4(transmittedColor, 1.0);
      if (debugMode == 4u)
        return float4(reflectionLighting, 1.0);
      if (debugMode == 5u)
        return float4(fresnel.xxx, 1.0);
      if (debugMode == 6u)
        return float4(saturate(thickness / 20.0).xxx, 1.0);
      if (debugMode == 7u)
        return float4(authoredTint, 1.0);
      if (debugMode == 8u)
        return float4(profileA.DeepColor.rgb, 1.0); // first profile of the pair, no blend
      if (debugMode == 9u)
        return float4(profileB.DeepColor.rgb, 1.0); // second profile of the pair, no blend
      if (debugMode == 10u)
        return float4(profileB.ScatteringAndIor.rgb * 4.0, 1.0); // second profile of the pair, scaled for visibility
      if (debugMode == 11u)
        return float4(input.Normal * 0.5 + 0.5, 1.0);
      if (debugMode == 12u)
        return float4(engineLighting.diffuseLight, 1.0); // scene diffuse lighting on the water surface
      if (debugMode == 13u)
        return float4(diffuseIrradiance * 0.2, 1.0); // analytic irradiance (scaled)
      if (debugMode == 14u)
        return float4(litTint, 1.0); // authored tint after lighting
      if (debugMode == 15u)
        return float4(MainLightColorIntensity.rgb * 0.1, 1.0); // raw main light (scaled)
      if (debugMode == 16u || debugMode == 17u)
      {
        // 16: the sun's shadow at the water surface (white is lit). 17: whether the shadow map covers the surface.
        float3 coverage;
        const float sunShadow = EvaluateWaterSunShadow(input.WorldPosition, float3(0.0, 0.0, 1.0), input.Position.xyw, coverage);
        return float4(debugMode == 16u ? sunShadow.xxx : coverage, 1.0);
      }
      return float4(PreExpose(engineLighting.specularLight), 1.0); // 18+: the engine's direct specular
    }
  }
#endif

  float3 color = transmittedColor * (1.0 - fresnel) + reflectionLighting;
  // Foam uses the same analytic irradiance as the tint - engineLighting.diffuseLight is zeroed over water
  // by the depth-derived shadow systems (see diffuseIrradiance above). Aerated white water is dominated by
  // diffuse multiple scattering and suppresses the coherent interface reflection underneath it; adding a second
  // full sun/environment specular lobe makes foam converge to the same bright radiance as reflective water.
  const float foamPerceptualRoughness = saturate(max(foamMaterialParams.x, 0.20));
  // Prefer the analytic irradiance used by water, but retain valid clustered radiance when a custom pipeline
  // does not publish the dominant-light frame data (for example lightweight preview and unit-test pipelines).
  // Keep both candidates in radiance units: engineLighting.diffuseLight already includes the material albedo.
  const float3 analyticFoamDiffuse = foamColor.rgb * diffuseIrradiance;
  const float3 foamDiffuseLighting = max(analyticFoamDiffuse, engineLighting.diffuseLight);
  plMaterialData foamBrdfMaterial = materialData;
  foamBrdfMaterial.specularColor = float3(0.02, 0.02, 0.02);
  foamBrdfMaterial.perceptualRoughness = foamPerceptualRoughness;
  foamBrdfMaterial.roughness = foamPerceptualRoughness * foamPerceptualRoughness;
  const AccumulatedLight foamSunBrdf = DefaultShading(foamBrdfMaterial, mainLightDirection, viewDirection);
  const float3 foamSunSpecular = sunRadiance * foamSunBrdf.specularLight * INV_PI;
  const float3 foamLighting = foamDiffuseLighting + foamSunSpecular + lowEnergySceneFallback * missingLighting;
  // Interpret the foam signal as optical density rather than a linear color weight. Thin aerated crests become
  // visible without driving established white water past full coverage, where the exponential naturally saturates.
  const float foamCoverage = 1.0 - exp(-foam * 2.5);
  color = lerp(color, foamLighting, foamCoverage * saturate(foamColor.a));
  // Shallow water is clear, and it is still water: its surface reflects whatever its depth. (The old shore fade
  // blended the whole surface away over Shore Fade Depth along the view ray, so from above a metre of water over sand
  // was not there at all.) All that is faded is the last few centimetres, where the surface meets the ground and a
  // hard line would show the mesh.
  const float softEdgeDepth = clamp(opticalParams.w * 0.05, 0.01, 0.15);
  const float shoreVisibility = cameraOnNormalSide ? smoothstep(0.0, softEdgeDepth, verticalDepth) : 1.0;
  color = lerp(undistortedSceneColor, color, shoreVisibility);

#if RENDER_PASS == RENDER_PASS_EDITOR
  // Modern water does not use MaterialPixelShader.h, so it must provide the same view-mode contract itself.
  // Map each mode to the closest physically meaningful water channel while retaining the engine conventions
  // for unavailable vertex streams, heat maps, depth, GI inspection and static/dynamic classification.
  const float effectiveFoamCoverage = foamCoverage * saturate(foamColor.a);
  const float3 effectiveDiffuseColor = lerp(authoredTint, foamColor.rgb, effectiveFoamCoverage);
  const float3 effectiveSpecularColor = lerp(f0.xxx, float3(0.02, 0.02, 0.02), effectiveFoamCoverage);
  const float effectiveRoughness = lerp(materialData.roughness, foamBrdfMaterial.roughness, effectiveFoamCoverage);

  if (RenderPass == EDITOR_RENDER_PASS_DIFFUSE_LIT_ONLY)
  {
    const float3 diffuseOnly = lerp(transmittedColor * (1.0 - fresnel), foamDiffuseLighting, effectiveFoamCoverage);
    return float4(SrgbToLinear(diffuseOnly * Exposure), 1.0);
  }
  if (RenderPass == EDITOR_RENDER_PASS_SPECULAR_LIT_ONLY)
  {
    const float3 specularOnly = lerp(reflectionLighting, foamSunSpecular, effectiveFoamCoverage);
    return float4(SrgbToLinear(specularOnly * Exposure), 1.0);
  }
  if (RenderPass == EDITOR_RENDER_PASS_LIGHT_COUNT || RenderPass == EDITOR_RENDER_PASS_DECAL_COUNT)
  {
    const float itemCount = RenderPass == EDITOR_RENDER_PASS_LIGHT_COUNT
                              ? GET_LIGHT_INDEX(clusterData.counts)
                              : GET_DECAL_INDEX(clusterData.counts);
    float3 heatmap = 0.0;
    if (itemCount > 0.0)
    {
      const float x = (itemCount - 1.0) / 16.0;
      heatmap.r = saturate(x);
      heatmap.g = saturate(2.0 - x);
    }
    return float4(lerp(color, heatmap, 0.7), 1.0);
  }
  if (RenderPass == EDITOR_RENDER_PASS_TEXCOORDS_UV0)
    return float4(SrgbToLinear(float3(frac(input.TexCoord0.xy), 0.0)), 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_TEXCOORDS_UV1)
  {
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
    return float4(SrgbToLinear(float3(frac(input.TexCoord1.xy), 0.0)), 1.0);
#else
    return float4(0.0, 0.0, 0.0, 1.0);
#endif
  }
  if (RenderPass == EDITOR_RENDER_PASS_VERTEX_COLORS0)
  {
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
    return float4(SrgbToLinear(input.Color0.rgb), 1.0);
#else
    return float4(0.0, 0.0, 0.0, 1.0);
#endif
  }
  if (RenderPass == EDITOR_RENDER_PASS_VERTEX_COLORS1)
    return float4(0.0, 0.0, 0.0, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_VERTEX_NORMALS)
    return float4(SrgbToLinear(normalize(input.Normal) * 0.5 + 0.5), 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_VERTEX_TANGENTS)
  {
#if WATER_GEOMETRY_SOURCE == WATER_GEOMETRY_SOURCE_FINITE
    return float4(SrgbToLinear(normalize(input.Tangent) * 0.5 + 0.5), 1.0);
#else
    return float4(0.0, 0.0, 0.0, 1.0);
#endif
  }
  if (RenderPass == EDITOR_RENDER_PASS_PIXEL_NORMALS)
    return float4(SrgbToLinear(normal * 0.5 + 0.5), 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_DIFFUSE_COLOR)
    return float4(effectiveDiffuseColor, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_DIFFUSE_COLOR_RANGE)
  {
    const float luminance = GetLuminance(effectiveDiffuseColor);
    if (luminance < 0.017)
      return float4(1.0, 0.0, 1.0, 1.0);
    if (luminance > 0.9)
      return float4(0.0, 1.0, 0.0, 1.0);
    return float4(effectiveDiffuseColor, 1.0);
  }
  if (RenderPass == EDITOR_RENDER_PASS_SPECULAR_COLOR)
    return float4(effectiveSpecularColor, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_EMISSIVE_COLOR)
    return float4(0.0, 0.0, 0.0, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_ROUGHNESS)
    return float4(SrgbToLinear(effectiveRoughness).xxx, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_OCCLUSION || RenderPass == EDITOR_RENDER_PASS_RTAO)
    return float4(SrgbToLinear(SampleSSAO(input.Position.xyw)).xxx, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_DEPTH)
    return float4(SrgbToLinear(input.Position.w * ClipPlanes.z).xxx, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_STATIC_VS_DYNAMIC)
    return float4(0.65, 0.0, 0.0, 1.0); // Every displaced water draw is classified as dynamic render data.
  if (RenderPass == EDITOR_RENDER_PASS_BONE_WEIGHTS)
    return float4(0.05, 0.05, 0.1, 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_GI_DIFFUSE)
    return float4(SrgbToLinear(SampleGIForwardDiffuse(input.Position.xyw, input.WorldPosition) * GIDiffuseStrength * Exposure), 1.0);
  if (RenderPass == EDITOR_RENDER_PASS_GI_SPECULAR)
  {
    const float3 giBrdf = EnvironmentBRDF(effectiveSpecularColor, effectiveRoughness, noV);
    return float4(SrgbToLinear(SampleGIForwardSpecular(input.Position.xyw, input.WorldPosition) * giBrdf * GISpecularStrength * Exposure), 1.0);
  }
  if (RenderPass == EDITOR_RENDER_PASS_GI_COMBINED)
  {
    const float3 giBrdf = EnvironmentBRDF(effectiveSpecularColor, effectiveRoughness, noV);
    const float3 giLighting = SampleGIForwardDiffuse(input.Position.xyw, input.WorldPosition) * GIDiffuseStrength +
                              SampleGIForwardSpecular(input.Position.xyw, input.WorldPosition) * giBrdf * GISpecularStrength;
    return float4(SrgbToLinear(giLighting * Exposure), 1.0);
  }

  return float4(1.0, 0.0, 1.0, 1.0);
#endif

  return float4(PreExpose(color), 1.0);
}

#endif
